{
  "name": "claude-revive",
  "displayName": "Claude Revive",
  "description": "Reopen Claude sessions killed by a reboot as normal bash terminals.",
  "version": "0.0.2",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coezbek/claude-revive"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeRevive.restore",
        "title": "Restore killed sessions",
        "category": "Claude Revive"
      },
      {
        "command": "claudeRevive.setupHooks",
        "title": "Set up Claude hooks",
        "category": "Claude Revive"
      }
    ]
  }
}
